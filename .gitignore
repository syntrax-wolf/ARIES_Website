# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# leftover Next build cache
/.next/

# astro / workers
web/node_modules
web/dist
web/.astro
/dist
/.astro
.wrangler
web/.wrangler
web/.seed.sql
web/.dev.vars
.dev.vars

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
!web/.env.example
!web/.dev.vars.example

# imported sheet exports (re-fetch via import script)
/data/
