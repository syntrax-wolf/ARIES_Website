# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# astro / workers
web/node_modules
web/dist
web/.astro
.wrangler

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# imported sheet exports (re-fetch via import script)
/data/

# Generated Supabase seed SQL (recreate with node scripts/generate-seed-sql.mjs)
/scripts/generated-seed.sql
/scripts/seed-chunks/
/scripts/excel-mail-name.json
/scripts/excel-kerberos.json
/scripts/kerberos-updates.sql
