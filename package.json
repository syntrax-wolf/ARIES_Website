{
  "name": "aries-website",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "web"
  ],
  "scripts": {
    "dev": "npm run dev -w aries-website-web",
    "build": "npm run build -w aries-website-web",
    "preview": "npm run preview -w aries-website-web",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test src/**/*.test.ts web/src/**/*.test.ts",
    "db:seed": "npm run db:seed -w aries-website-web"
  },
  "devDependencies": {
    "@types/node": "^20",
    "typescript": "^5"
  },
  "allowScripts": {
    "sharp@0.34.5": true,
    "esbuild@0.28.1": true,
    "workerd@1.20260815.1": true
  }
}
