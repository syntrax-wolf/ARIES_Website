# Supabase (ARIES_Website project) — required on Vercel
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only: privileged writes + seed scripts (never expose to browser)
SUPABASE_SERVICE_ROLE_KEY=

# DevClub / IIT Delhi OAuth (https://auth.devclub.in/docs)
DEVCLUB_CLIENT_ID=
DEVCLUB_CLIENT_SECRET=
# Must match a registered redirect URI exactly
DEVCLUB_REDIRECT_URI=http://localhost:3000/api/auth/callback/devclub

# Optional staff accounts for dual-run / blogger (no default passwords)
ADMIN_USER=admin
ADMIN_PASSWORD=
BLOGGER_USER=blogger
BLOGGER_PASSWORD=

# Sanity CMS (blog feature) — required on Vercel for /blog pages
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=
