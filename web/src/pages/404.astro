---
export const prerender = true;

import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Page not found | ARIES IIT Delhi"
  description="This page is not on the ARIES site."
  noindex
>
  <main class="flex min-h-screen flex-col items-center justify-center bg-cream px-6 text-center">
    <p class="text-sm font-bold uppercase tracking-wider text-purple">404</p>
    <h1 class="mt-3 text-4xl font-black text-ink">This page is not here.</h1>
    <p class="mt-4 max-w-md text-ink/70">The URL may be old, or the page was never published.</p>
    <a href="/" class="mt-8 rounded-full bg-navy px-6 py-3 text-sm font-bold text-white">Back to home</a>
  </main>
</Layout>
