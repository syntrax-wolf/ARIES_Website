---
export const prerender = true;

import Layout from "../../layouts/Layout.astro";
import InnerChrome from "../../layouts/InnerChrome.astro";
import { PageHero } from "../../components/ui/PageHero";
import { EventsExplorer } from "../../components/events/EventsExplorer";
import { loadBuildStore } from "../../lib/content/build-store";

const { upcoming, past } = (await loadBuildStore()).splitEvents();
---

<Layout
  title="Events | ARIES IIT Delhi"
  description="Talks, workshops, hackathons, and industry events from ARIES at IIT Delhi."
>
  <InnerChrome>
  <div class="relative min-h-screen overflow-hidden bg-[linear-gradient(178deg,#fffaf3_1%,#fbf5ec_64%,#8378ff_140%)] pt-16 lg:pt-0">
    <div class="glow-circle absolute -right-24 top-16 size-[380px]"></div>
    <div class="mx-auto max-w-[1360px] px-6 md:px-16">
      <PageHero
        eyebrow="Events"
        title="Ideas spark."
        accent="Impact"
        titleSuffix="follows."
        subtitle="Explore conversations, collaborations and creations that move the ARIES community forward."
      />
      <EventsExplorer client:visible upcoming={upcoming} past={past} />
    </div>
  </div>
  </InnerChrome>
</Layout>
