---
import Layout from "../../layouts/Layout.astro";
import { TopNav } from "../../components/landing/TopNav";
import { PageHero } from "../../components/ui/PageHero";
import { EventsExplorer } from "../../components/events/EventsExplorer";
import { loadJsonBackupStore } from "../../lib/content/store";

const { upcoming, past } = loadJsonBackupStore().splitEvents();
---

<Layout title="Events | ARIES IIT Delhi">
  <TopNav client:load />
  <div class="relative min-h-screen overflow-hidden bg-[linear-gradient(178deg,#fffaf3_1%,#fbf5ec_64%,#8378ff_140%)] pt-16">
    <div class="glow-circle absolute -right-24 top-16 size-[380px]"></div>
    <div class="mx-auto max-w-[1360px] px-6 md:px-16">
      <PageHero
        eyebrow="Events"
        title="Ideas spark."
        accent="Impact"
        titleSuffix="follows."
        subtitle="Explore conversations, collaborations and creations that move the ARIES community forward."
      />
      <EventsExplorer client:load upcoming={upcoming} past={past} />
    </div>
  </div>
</Layout>
