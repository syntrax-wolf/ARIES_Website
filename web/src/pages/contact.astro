---
export const prerender = true;

import { Mail, MapPin, ExternalLink } from "lucide-react";
import Layout from "../layouts/Layout.astro";
import InnerChrome from "../layouts/InnerChrome.astro";
import { ContactForm } from "../components/contact/ContactForm";
import { clubSocials, clubEmail, clubLocation } from "../config/socials";

const socialGlyphs: Record<string, string> = {
  LinkedIn: "in",
  Email: "@",
};
---

<Layout
  title="Contact | ARIES IIT Delhi"
  description="Reach ARIES at IIT Delhi — email, LinkedIn, and campus location."
>
  <InnerChrome>
  <div class="relative min-h-screen overflow-hidden bg-[#fbf4ec] pt-16 lg:pt-0">
    <div class="absolute -right-20 -top-16 size-72 rounded-full bg-[#e4dcf7]"></div>
    <div class="absolute right-40 top-28 size-40 rounded-full bg-[#f3e7d3]"></div>

    <div class="relative mx-auto max-w-[1240px] px-6 pb-20 pt-14 md:px-12">
      <h1 class="text-5xl font-black leading-[1.1] text-ink">
        Let&rsquo;s
        <br />
        <span class="text-purple underline decoration-purple/50 decoration-4 underline-offset-8">
          Connect!
        </span>
      </h1>
      <p class="mt-6 max-w-md text-sm leading-6 text-ink/70">
        Reach out for collaborations, opportunities, or to update or add your alumni profile on the
        team page.
      </p>

      <div class="mt-10 grid gap-6 lg:grid-cols-[1.4fr_1fr]">
        <ContactForm client:idle />

        <aside class="rounded-2xl bg-white p-7 shadow-card-sm">
          <h2 class="text-lg font-bold text-ink">Get in touch</h2>
          <p class="mt-2 text-xs text-ink/60">
            Alumni can update or add their details here — we&rsquo;ll take care of the rest.
          </p>
          <div class="mt-8 space-y-6">
            <p class="flex items-start gap-4">
              <span class="grid size-10 shrink-0 place-items-center rounded-lg bg-lilac text-purple">
                <Mail size={17} />
              </span>
              <span>
                <span class="block text-sm font-bold text-ink">Email</span>
                <a href={`mailto:${clubEmail}`} class="text-sm text-ink/70 hover:text-purple">
                  {clubEmail}
                </a>
              </span>
            </p>
            <p class="flex items-start gap-4">
              <span class="grid size-10 shrink-0 place-items-center rounded-lg bg-lilac text-purple">
                <MapPin size={17} />
              </span>
              <span>
                <span class="block text-sm font-bold text-ink">Location</span>
                <span class="text-sm text-ink/70">{clubLocation}</span>
              </span>
            </p>
          </div>
          <hr class="my-8 border-[#f0e8dc]" />
          <p class="text-center text-sm italic text-ink/60">
            Great things happen when we collaborate.
          </p>
        </aside>
      </div>

      <div class="mt-8 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-2">
        {
          clubSocials.map((s) => (
            <a
              href={s.url}
              target={s.url.startsWith("mailto:") ? undefined : "_blank"}
              rel="noreferrer"
              class="group flex items-center gap-4 rounded-2xl bg-white p-5 shadow-card-sm transition-transform hover:-translate-y-0.5"
            >
              <span class="grid size-12 place-items-center rounded-xl bg-navy text-sm font-black text-white">
                {socialGlyphs[s.label] ?? s.label[0]}
              </span>
              <span class="min-w-0 flex-1">
                <span class="block text-sm font-bold text-ink">{s.label}</span>
                <span class="block truncate text-xs text-ink/55">{s.handle}</span>
              </span>
              <ExternalLink size={15} class="shrink-0 text-ink/30 transition-colors group-hover:text-purple" />
            </a>
          ))
        }
      </div>
    </div>
  </div>
  </InnerChrome>
</Layout>
