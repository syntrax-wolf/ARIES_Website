---
export const prerender = false;

import Layout from "../../layouts/Layout.astro";
import { TopNav } from "../../components/landing/TopNav";
import { AdminEditor } from "../../components/admin/AdminEditor";
import { createWritableStore } from "../../lib/content/d1";
import { projectsEditableBy, resolveActor } from "../../lib/content/actor";
import { documentDbFromLocals } from "../../lib/gate/runtime";
import { sessionFromRequest } from "../../lib/gate/request";

const session = sessionFromRequest(Astro.request);
if (!session) {
  return Astro.redirect("/admin");
}

const db = await documentDbFromLocals(Astro.locals);
const store = createWritableStore(db);
const actor = await resolveActor(store, session);
const projects = projectsEditableBy(actor, await store.listProjects());
const label =
  session.kind === "admin" ? "Bootstrap Admin" : `Kerberos ${session.kerberos ?? ""}`;
---

<Layout title="Editor | ARIES IIT Delhi">
  <TopNav client:load />
  <div class="min-h-screen bg-[#fbf4ec] px-6 pt-32 pb-16">
    <div class="mx-auto max-w-5xl">
      <AdminEditor client:load projects={projects} label={label} />
    </div>
  </div>
</Layout>
