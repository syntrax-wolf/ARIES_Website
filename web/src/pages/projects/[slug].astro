---
import Layout from "../../layouts/Layout.astro";
import InnerChrome from "../../layouts/InnerChrome.astro";
import { CategoryBadge } from "../../components/ui/CategoryBadge";
import { Tag } from "../../components/ui/Tag";
import { loadBuildStore } from "../../lib/content/build-store";

export async function getStaticPaths() {
  const store = await loadBuildStore();
  return store.listProjects().map((p) => ({ params: { slug: p.slug } }));
}

export const prerender = true;

const { slug } = Astro.params;
const project = (await loadBuildStore()).getProject(slug!);
if (!project) {
  return new Response(null, { status: 404, statusText: "Not Found" });
}
---

<Layout
  title={`${project.name}${project.accent ? ` ${project.accent}` : ""} | ARIES IIT Delhi`}
  description={project.tagline || project.description}
  jsonLd={{
    "@context": "https://schema.org",
    "@type": "CreativeWork",
    name: `${project.name}${project.accent ? ` ${project.accent}` : ""}`,
    description: project.description,
    url: Astro.url.href,
  }}
>
  <InnerChrome>
  <div class="min-h-screen bg-[#fdf6ee] pt-16 lg:pt-0">
    <div class="mx-auto max-w-[1240px] px-6 pb-20 pt-14 md:px-12">
      <div class="grid items-center gap-10 lg:grid-cols-[1.15fr_1fr]">
        <div>
          {
            project.featured && (
              <span class="inline-block rounded-full bg-lilac px-4 py-1.5 text-xs font-bold uppercase tracking-wider text-purple">
                Featured Project
              </span>
            )
          }
          <h1 class="mt-5 text-4xl font-black leading-tight text-ink md:text-6xl">
            {project.name}{" "}
            {project.accent && <span class="text-purple">{project.accent}</span>}
          </h1>
          <p class="mt-5 text-lg font-bold text-ink">{project.tagline}</p>
          <p class="mt-4 max-w-lg text-[15px] leading-7 text-ink/80">{project.description}</p>
          <div class="mt-6 flex flex-wrap gap-2">
            {project.tags.map((t) => (
              <span class="rounded-md bg-[#e9e4fb] px-3 py-1.5 text-xs font-semibold text-[#3947b8]">
                {t}
              </span>
            ))}
          </div>
        </div>
        <div class="relative aspect-[3/2] overflow-hidden rounded-3xl bg-[radial-gradient(circle_at_50%_45%,#2c2069_0%,#161042_55%,#0d0a30_100%)] shadow-[0px_30px_60px_rgba(21,14,65,0.35)]">
          {
            project.image ? (
              <img src={project.image} alt="" class="h-full w-full object-cover" />
            ) : null
          }
        </div>
      </div>

      {
        (project.about || project.description) && (
          <div class="mt-16">
            <h2 class="text-xl font-bold text-ink">
              About the Project
              <span class="mt-2 block h-1 w-8 rounded bg-purple" />
            </h2>
            <p class="mt-6 text-[15px] font-medium leading-8 text-ink">
              {project.about || project.description}
            </p>
          </div>
        )
      }

      {
        (project.techStack ?? []).length > 0 && (
          <div class="mt-10">
            <h2 class="text-xl font-bold text-ink">
              Tech Stack
              <span class="mt-2 block h-1 w-8 rounded bg-purple" />
            </h2>
            <div class="mt-5 flex flex-wrap gap-2.5">
              {project.techStack!.map((t) => (
                <Tag className="bg-white px-4 py-2 text-[13px] shadow-card-sm">{t}</Tag>
              ))}
            </div>
          </div>
        )
      }

      <div class="mt-14">
        <CategoryBadge label={project.category} />
      </div>
    </div>
  </div>
  </InnerChrome>
</Layout>
