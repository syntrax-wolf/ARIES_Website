---
export const prerender = false;

import Layout from "../layouts/Layout.astro";
import { TopNav } from "../components/landing/TopNav";
import { sessionFromRequest } from "../lib/gate/request";

const session = sessionFromRequest(Astro.request);
if (!session) {
  return Astro.redirect("/admin");
}
---

<Layout title="Account | ARIES IIT Delhi">
  <TopNav client:load />
  <div class="min-h-screen bg-[#fbf4ec] px-6 pt-32">
    <div class="mx-auto max-w-lg rounded-2xl bg-white p-8 shadow-card-sm">
      <h1 class="text-2xl font-black text-ink">Signed in</h1>
      <p class="mt-3 text-sm text-ink/70">
        {
          session.kind === "admin"
            ? "Bootstrap Admin Session. Public pages still do not use this cookie."
            : `Kerberos ${session.kerberos} passed the Allowlist Gate.`
        }
      </p>
      <div class="mt-6 flex flex-wrap gap-3">
        <a
          href="/admin/editor"
          class="rounded-xl bg-purple px-5 py-2.5 text-sm font-bold text-white"
        >
          Open editor
        </a>
        <form method="post" action="/api/auth/logout">
          <button class="rounded-xl bg-navy px-5 py-2.5 text-sm font-bold text-white" type="submit">
            Sign out
          </button>
        </form>
      </div>
    </div>
  </div>
</Layout>
