# Session cookie HMAC. Required for Gate cookies.
SESSION_SECRET=

# Bootstrap Admin password. Only identifier `admin` plus this secret may mint an Admin Session.
ADMIN_PASSWORD=

# DevClub OIDC (Kerberos login). Leave empty to disable IIT Delhi sign-in locally.
DEVCLUB_CLIENT_ID=
DEVCLUB_CLIENT_SECRET=
DEVCLUB_REDIRECT_URI=

# Build public HTML from local D1 instead of content/*.json
# ARIES_CONTENT_SOURCE=d1

# Comma-separated Kerberos ids used only when D1 is unavailable (local astro dev).
# ARIES_ALLOWLIST=cs1230001

# Public base for R2 Media URLs (Worker serves /media/*).
# MEDIA_PUBLIC_BASE=/media

# Cloudflare deploy hook name (not the secret). POSTed after a successful CMS write
# so public HTML is rebuilt as static assets. Leave empty to skip locally.
# REBUILD_HOOK_URL=
